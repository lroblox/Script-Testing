startActionLog = function()
	if logging then return end
	logging = true
	local lines = {}
	local t0 = os.clock()

local function add(s)
		if #lines < 300 then
			table.insert(lines, string.format("[%.1fs] %s", os.clock() - t0, s))
		end
	end
	local function rgb(c)
		return math.floor(c.R * 255) .. "," .. math.floor(c.G * 255) .. "," .. math.floor(c.B * 255)
	end
	local function f1(x) return string.format("%.1f", x) end

add("Target: " .. (currentMob and currentMob:GetFullName() or "không có"))
	do
		local k = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("Humanoid") and k < 20 then
				k += 1
				local m = d.Parent
				add(string.format("HUM %s | maxhp %s | hp %s | %s", tostring(m and m.Name), tostring(d.MaxHealth),
					tostring(math.floor(d.Health)), m and m:GetFullName() or "?"))
			end
		end
	end
	dodgeStatus.Text = "Đang ghi log " .. CONFIG.LogSeconds .. "s: hãy để boss tung chiêu..."

local c1 = workspace.DescendantAdded:Connect(function(i)
		task.defer(function()
			if not logging then return end
			if i:IsA("BasePart") then
				if isPlayerPart(i) or i == workspace.Terrain then return end
				add(string.format("PART %s | size %s,%s,%s | rgb %s | collide=%s tr=%.2f %s | %s",
					i.Name, f1(i.Size.X), f1(i.Size.Y), f1(i.Size.Z), rgb(i.Color),
					tostring(i.CanCollide), i.Transparency, tostring(i.Material), i:GetFullName()))
			elseif i:IsA("Decal") or i:IsA("Texture") then
				add(string.format("DECAL %s | rgb %s | %s", i.Name, rgb(i.Color3), i:GetFullName()))
			elseif i:IsA("Beam") then
				add(string.format("BEAM %s | width %s,%s | %s", i.Name, f1(i.Width0), f1(i.Width1), i:GetFullName()))
			elseif i:IsA("SurfaceGui") or i:IsA("BillboardGui") then
				add(string.format("GUI3D %s %s | %s", i.ClassName, i.Name, i:GetFullName()))
			elseif i:IsA("ImageLabel") and i:FindFirstAncestorOfClass("SurfaceGui") then
				add(string.format("IMAGE %s | rgb %s | %s", i.Name, rgb(i.ImageColor3), i:GetFullName()))
			end
		end)
	end)

local _, _, hum = getChar()
	local hc
	if hum then
		local last = hum.Health
		hc = hum.HealthChanged:Connect(function(h)
			if h < last - 0.5 then
				add("HP -" .. math.floor(last - h) .. " (còn " .. math.floor(h) .. ")")
			end
			last = h
		end)
	end

task.spawn(function()
		local seen = setmetatable({}, { __mode = "k" })
		while logging and os.clock() - t0 < CONFIG.LogSeconds do
			if currentMob then
				local an = currentMob:FindFirstChildWhichIsA("Animator", true)
				if an then
					for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
						if not seen[tr] then
							seen[tr] = true
							add(string.format("ANIM %s | id %s | len %s | looped=%s | prio %s",
								animName(tr), tostring(tr.Animation and tr.Animation.AnimationId),
								f1(tr.Length), tostring(tr.Looped), tostring(tr.Priority)))
						end
					end
				end
			end
			task.wait(0.15)
		end
	end)

task.delay(CONFIG.LogSeconds, function()
		logging = false
		c1:Disconnect()
		if hc then hc:Disconnect() end
		local text = table.concat(lines, "\n")
		print("[LotScript LOG]\n" .. text)
		local copied = false
		pcall(function()
			if setclipboard then
				setclipboard(text)
				copied = true
			end
		end)
		dodgeStatus.Text = "Log xong: " .. #lines .. " dòng" .. (copied and " (đã copy vào clipboard, dán gửi tôi)" or " (xem console F9)")
	end)
end

