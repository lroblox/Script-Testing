	manualAttempts += 1
	task.spawn(runVoteAttempt, voteMode or "replay", manualAttempts)
end)

task.spawn(function()
	local attempts, lastAttempt = 0, 0
	while gui.Parent do
		if voteMode and not learnMode then
			local shown = (not CONFIG.RequireResultScreen) or resultScreenShown()
			if shown then
				if voteSucceeded(voteMode) then
					if not voted then
						voted = true
						if lastMethod[voteMode] then working[voteMode] = lastMethod[voteMode] end
						voteStatus.Text = "Đã vote thành công sau " .. attempts .. " lần thử."
					end
				else
					local lbl = findVoteLabel(voteMode)
					local gap = (lbl and getVotes(lbl) ~= nil) and 1.5 or 2.5
					if os.clock() - lastAttempt >= gap then
						lastAttempt = os.clock()
						attempts += 1
						pcall(runVoteAttempt, voteMode, attempts)
					end
				end
			else
				voted = false
				attempts = 0
				if voteMode then voteStatus.Text = "Chờ màn hình kết quả (Victory/Defeat)..." end
			end
		end
		task.wait(0.3)
	end
end)
