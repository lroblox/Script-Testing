end

local function moveStep(dt)
	if not (keepOn and desiredPoint) then return end
	local _, hrp, hum = getChar()
	if not (hrp and hum and hum.Health > 0) then return end
	local dir = flat(desiredPoint - hrp.Position)
	if dir.Magnitude < 0.6 then return end
	dir = dir.Unit
	if cframeMode then
		local step = math.max(hum.WalkSpeed, 8) * dt
		local newPos = hrp.Position + dir * step
		local face = targetOn and flat(hrp.CFrame.LookVector) or dir
		if face.Magnitude < 0.01 then face = dir end
		hrp.CFrame = CFrame.lookAt(newPos, newPos + face)
	else
		hum:Move(dir, false)
	end
end
-- [FIX] dùng tên hook riêng của lần chạy này
RunService:BindToRenderStep(MOVE_NAME, Enum.RenderPriority.Last.Value, moveStep)

local function planFallback(hrp, rootPos, dir)
	local goal = rootPos + dir * keepDistance
	goal = Vector3.new(goal.X, hrp.Position.Y, goal.Z)
	local ok = pcall(function() pathObj:ComputeAsync(hrp.Position, goal) end)
	if ok and pathObj.Status == Enum.PathStatus.Success then
		local pts = {}
		for _, wp in ipairs(pathObj:GetWaypoints()) do table.insert(pts, wp.Position) end
		return pts
	end
	return { goal }
end

task.spawn(function()
	while gui.Parent do
