			local dxg = math.sqrt((hrp.Position.X - grid.cx) ^ 2 + (hrp.Position.Z - grid.cz) ^ 2)
			if dxg > grid.R - 14 and not scanning and os.clock() - lastScanAt > 8 then
				requestScan(true)
			end
		end

if not (currentTarget and currentTarget.Parent) then
			desiredPoint = nil
			keepStatus.Text = "Giữ khoảng cách: chưa thấy boss (kiểm tra CONFIG.BossName). " .. mapNote
			continue
		end

local rootPos = currentTarget.Position
		local rel = flat(hrp.Position - rootPos)
		local d = rel.Magnitude
		local dir = (d > 0.1) and rel.Unit or Vector3.new(1, 0, 0)
		local tol = CONFIG.DistanceTolerance
		local now = os.clock()

-- đang né chiêu: dừng đi bộ, nhường cho tele
		if dodgeOn and now < Z.hold then
			desiredPoint = nil
			continue
		end

local zs = dodgeOn and Z.build() or {}

if moveMode == nil or moveMode == "settle" then
			if d > keepDistance + tol then
				moveMode = "approach"
			elseif d < keepDistance - tol then
