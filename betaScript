function Z.flatRadius(part)
	local s = part.Size
	local thin = math.min(s.X, s.Y, s.Z)
	local big = math.max(s.X, s.Y, s.Z)
	if thin > 2.5 then return nil end
	local axis
	if s.X == thin then axis = part.CFrame.RightVector
	elseif s.Y == thin then axis = part.CFrame.UpVector
	else axis = part.CFrame.LookVector end
	if math.abs(axis.Y) < 0.8 then return nil end
	local mid = s.X + s.Y + s.Z - thin - big
	if mid < big * 0.6 then return nil end
	return big / 2
end

function Z.footprint(part)
	local cf, s = part.CFrame, part.Size
	local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	local hx = (math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z) / 2
	local hz = (math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z) / 2
	return cf.Position.X, cf.Position.Z, hx, hz
end

function Z.scanFX()
	local now = os.clock()
	if now - Z.lastFx < CONFIG.FxScanInterval then return end
	Z.lastFx = now
	local fx = workspace:FindFirstChild("FX")
	if not fx then return end
	for _, d in ipairs(fx:GetDescendants()) do
		if d:IsA("BasePart") and not Z.seen[d] then
			local nl = d.Name:lower()

local pillar = false
			local cur = d
			while cur and cur ~= fx do
				if matchAny(cur.Name:lower(), CONFIG.PillarKeywords) then pillar = true break end
				cur = cur.Parent
			end

if pillar then
				Z.seen[d] = now
				Z.info[d] = { pad = CONFIG.PillarPadding }
				dangerParts[d] = now + CONFIG.DangerTTL
				lastTrigger = "trụ băng"
			elseif not CONFIG.IgnoreFxNames[nl] and not isPlayerPart(d) then
				local rad = Z.flatRadius(d)
				if rad then
					local c = d.Color
					local red = isRed(c)
					local dark = (c.R + c.G + c.B) / 3 < 0.12
					local kw = matchAny(nl, CONFIG.DangerKeywords)
					local named = kw or matchAny(nl, CONFIG.CircleNames)
					if (named and (red or dark or kw)) or (red and rad >= 8) then
						Z.seen[d] = now
						Z.info[d] = { minR = red and CONFIG.RedCircleRadius or CONFIG.IndicatorRadius }
						dangerParts[d] = now + CONFIG.DangerTTL
						lastTrigger = (red and "vòng đỏ " or "vòng cảnh báo ") .. d.Name
						dbg("FX circle:", d:GetFullName())
					end
				end
			end
		end
	end
end

function Z.build()
	local now = os.clock()
	local zs = {}
	local pad = math.max(CONFIG.DangerPadding, CONFIG.TelegraphPadding)

for part, exp in pairs(dangerParts) do
		if part.Parent and exp > now then
			local info = Z.info[part]
			local p = part.Position
			local rad
			if part:IsA("Part") and part.Shape == Enum.PartType.Ball then
				rad = part.Size.X / 2
			else
				rad = Z.flatRadius(part)
			end
			if rad then
				if info and info.minR then rad = math.max(rad, info.minR) end
				zs[#zs + 1] = { x = p.X, z = p.Z, r = rad + pad, n = part.Name }
			else
				local x, z, hx, hz = Z.footprint(part)
				local pd = (info and info.pad) or pad
				zs[#zs + 1] = { x = x, z = z, hx = hx + pd, hz = hz + pd, n = part.Name }
			end
		end
	end

for obj, info in pairs(dangerCircles) do
		if obj.Parent and info.exp > now then
			zs[#zs + 1] = { x = obj.Position.X, z = obj.Position.Z, r = info.r + CONFIG.TelegraphPadding, n = "cột đỏ" }
		end
	end

for obj, exp in pairs(laserParts) do
		if obj.Parent and exp > now then
			local a, b, hw = laserSegment(obj)
			if a then
				zs[#zs + 1] = { seg = true, ax = a.X, az = a.Z, bx = b.X, bz = b.Z, r = hw + CONFIG.LaserPadding, n = "tia laser" }
			end
		end
	end

if virtualAim then
		zs[#zs + 1] = { seg = true, ax = virtualAim.a.X, az = virtualAim.a.Z, bx = virtualAim.b.X, bz = virtualAim.b.Z,
			r = CONFIG.LaserPadding + 2, n = "laser (animation)" }
	end
	return zs
end

function Z.hit(zs, x, z)
	for i = 1, #zs do
		local q = zs[i]
		if q.seg then
			local abx, abz = q.bx - q.ax, q.bz - q.az
			local l2 = abx * abx + abz * abz
			local t = 0
			if l2 > 1e-4 then t = math.clamp(((x - q.ax) * abx + (z - q.az) * abz) / l2, 0, 1) end
			local dx, dz = x - (q.ax + abx * t), z - (q.az + abz * t)
			if dx * dx + dz * dz <= q.r * q.r then return q end
		elseif q.r then
			local dx, dz = x - q.x, z - q.z
			if dx * dx + dz * dz <= q.r * q.r then return q end
		else
			if math.abs(x - q.x) <= q.hx and math.abs(z - q.z) <= q.hz then return q end
		end
	end
	return nil
end

local function effectiveRadius()
	local rad = CONFIG.MobAttackRadius
	if keepOn then rad = math.min(rad, keepDistance - CONFIG.DistanceTolerance - 1) end
	return rad
end

local function inDanger(pos, zs, quiet)
	zs = zs or Z.build()
	local q = Z.hit(zs, pos.X, pos.Z)
	if q then
		if not quiet then lastTrigger = q.n end
		return true
	end
	if #zs == 0 and os.clock() < attackUntil and currentTarget and currentTarget.Parent then
		if flat(pos - currentTarget.Position).Magnitude < effectiveRadius() then
			if not quiet then lastTrigger = "animation " .. lastAnim end
			return true
		end
	end
	return false
end

local function animName(tr)
	local n = tr.Animation and tr.Animation.Name or ""
	if n == "" or n == "Animation" then n = tr.Name or "" end
	return n:lower()
end

local function animKey(tr)
	local id = tr.Animation and tr.Animation.AnimationId or ""
	if id ~= "" then return id end
	return animName(tr)
end

local function isAttackAnim(tr)
	if tr.Looped then return false end
	local nm = animName(tr)
	if learnedAnims[animKey(tr)] then return true end
	if matchAny(nm, CONFIG.AttackAnimKeywords) then return true end
	if matchAny(nm, CONFIG.IgnoreAnimKeywords) then return false end
	local okp, pr = pcall(function() return tostring(tr.Priority) end)
	if okp and pr:find("Action") then return true end
	return false
end

local seenTracks = setmetatable({}, { __mode = "k" })
local function scanMobAttack()
	if not currentMob then return end
	local animator = currentMob:FindFirstChildWhichIsA("Animator", true)
	if not animator then return end
	for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
		local last = seenTracks[tr]
		local isNew = (last == nil) or (tr.TimePosition < last - 0.05)
		seenTracks[tr] = tr.TimePosition
		if tr.IsPlaying and matchAny(animName(tr), CONFIG.LaserAnimKeywords) then
			laserUntil = os.clock() + 0.6
		end
		if isNew and isAttackAnim(tr) then
			local now = os.clock()
			attackUntil = now + math.clamp(tr.Length - tr.TimePosition, 1, 4)
			lastAnim = animName(tr)
			for _, c in ipairs(recentCandidates) do
				if c.part.Parent and now - c.t <= 1.0 then
					dangerParts[c.part] = now + CONFIG.DangerTTL
					lastTrigger = "part lạ " .. c.part.Name
				end
			end
			recentCandidates = {}
			dbg("Mob attack anim:", lastAnim)
		end
	end
end

local function learnFromHit()
	local _, hrp = getChar()
	if not hrp then return end
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { player.Character }
	op.RespectCanCollide = false
	local okp, parts = pcall(function() return workspace:GetPartBoundsInRadius(hrp.Position, 6, op) end)
	if okp then
		for _, p in ipairs(parts) do
			if p ~= workspace.Terrain and not p.CanCollide and not GENERIC[p.Name]
				and not CONFIG.IgnoreFxNames[p.Name:lower()] and not p.Name:match("^Part%d*\$")
				and not insideRig(p) and not isPlayerPart(p) and biggest(p) >= 3 then
				if not learnedNames[p.Name] then print("[LotScript] Học hitbox:", p:GetFullName()) end
				learnedNames[p.Name] = true
				dangerParts[p] = os.clock() + CONFIG.DangerTTL
				lastTrigger = "đã học part " .. p.Name
			end
		end
	end
	if currentMob then
		local animator = currentMob:FindFirstChildWhichIsA("Animator", true)
		if animator then
			for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
				local nm = animName(tr)
				if tr.IsPlaying and not tr.Looped and not matchAny(nm, CONFIG.IgnoreAnimKeywords) then
					local key = animKey(tr)
					if not learnedAnims[key] then print("[LotScript] Học animation chiêu:", nm, key) end
					learnedAnims[key] = true
				end
			end
		end
	end
end

