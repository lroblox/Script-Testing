	for b in pairs(beamList) do
		if b.Parent and b.Enabled and b.Attachment0 and b.Attachment1
			and math.max(b.Width0, b.Width1) >= 1.5
			and not isPlayerPart(b.Attachment0.Parent)
			and (b.Attachment1.WorldPosition - b.Attachment0.WorldPosition).Magnitude >= CONFIG.LaserMinLength then
			laserParts[b] = now + 0.3
			lastTrigger = "beam " .. b.Name
		end
	end
end

