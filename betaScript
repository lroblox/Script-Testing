				targetStatus.Text = root and string.format("Mục tiêu: %s (%d studs)", name, math.floor(dist)) or "Mục tiêu: không thấy boss"
			end
		else
			currentTarget, currentMob = nil, nil
			bossCache = nil
			targetStatus.Text = "Mục tiêu: chưa có"
