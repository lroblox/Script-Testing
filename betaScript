-- A* trên lưới
----------------------------------------------------------------
local function heapPush(h, key, pri)
	local n = h.n + 1
	h.n = n
	h.k[n], h.p[n] = key, pri
	local i = n
	while i > 1 do
		local par = i // 2
		if h.p[par] <= h.p[i] then break end
		h.k[par], h.k[i] = h.k[i], h.k[par]
		h.p[par], h.p[i] = h.p[i], h.p[par]
		i = par
	end
end

local function heapPop(h)
	local n = h.n
	if n == 0 then return nil end
	local key = h.k[1]
	h.k[1], h.p[1] = h.k[n], h.p[n]
	h.k[n], h.p[n] = nil, nil
	n -= 1
	h.n = n
	local i = 1
	while true do
		local l, r, s = i * 2, i * 2 + 1, i
		if l <= n and h.p[l] < h.p[s] then s = l end
		if r <= n and h.p[r] < h.p[s] then s = r end
		if s == i then break end
		h.k[s], h.k[i] = h.k[i], h.k[s]
		h.p[s], h.p[i] = h.p[i], h.p[s]
		i = s
	end
	return key
end

local tempBlocked = {}

local function astar(startKey, isGoal, hfun, maxExp, penalty)
	local g = grid
	local N = g.N
	local now = os.clock()
	local open = { n = 0, k = {}, p = {} }
	local gs, came, closed = { [startKey] = 0 }, {}, {}
	heapPush(open, startKey, hfun(startKey))
	local exp = 0
	while true do
		local key = heapPop(open)
		if not key then return nil end
		if not closed[key] then
			closed[key] = true
			if isGoal(key) then
				local path = { key }
				while came[key] do
					key = came[key]
					table.insert(path, 1, key)
				end
				return path
			end
			exp += 1
			if exp > maxExp then return nil end
			local ix, iz = key // N, key % N
			for dx = -1, 1 do
				for dz = -1, 1 do
					if dx ~= 0 or dz ~= 0 then
						local jx, jz = ix + dx, iz + dz
						if jx >= 0 and jz >= 0 and jx < N and jz < N then
							local nk = jx * N + jz
							if g.walk[nk] and not closed[nk] and not (tempBlocked[nk] and tempBlocked[nk] > now)
								and math.abs(g.y[key] - g.y[nk]) <= CONFIG.MaxStep then
								local ok = true
								if dx ~= 0 and dz ~= 0 then
									ok = g.walk[(ix + dx) * N + iz] and g.walk[ix * N + (iz + dz)]
								end
								if ok then
									local step = (dx ~= 0 and dz ~= 0) and 1.414 or 1
									local ng = gs[key] + step * g.cs * (1 + penalty(nk))
									if not gs[nk] or ng < gs[nk] then
										gs[nk] = ng
										came[nk] = key
										heapPush(open, nk, ng + hfun(nk))
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

local function lineClear(a, b, zs)
	local g = grid
	local N = g.N
	local d = flat(b - a)
	local len = d.Magnitude
	if len < 0.1 then return true end
	local steps = math.ceil(len / (g.cs * 0.5))
	local lastY = a.Y
	local now = os.clock()
	for i = 1, steps do
		local p = a + d * (i / steps)
		local ix = math.floor((p.X - g.ox) / g.cs)
		local iz = math.floor((p.Z - g.oz) / g.cs)
		if ix < 0 or iz < 0 or ix >= N or iz >= N then return false end
		local key = ix * N + iz
		if not g.walk[key] or (tempBlocked[key] and tempBlocked[key] > now) then return false end
		if math.abs(g.y[key] - lastY) > CONFIG.MaxStep then return false end
		if zs and #zs > 0 and Z.hit(zs, p.X, p.Z) then return false end
		lastY = g.y[key]
	end
	return true
end

local function planGrid(hrp, rootPos, mode, zs)
	local g = grid
	local N = g.N
	local _, ix, iz = cellKeyOf(hrp.Position)
	if not ix then return nil end
	local startKey = nearestWalk(ix, iz)
	if not startKey then return nil end
	local bx, bz = rootPos.X, rootPos.Z
	local keep, tol = keepDistance, CONFIG.DistanceTolerance
	local dangerActive = #zs > 0

local function bdist(key)
		local jx, jz = key // N, key % N
		local x = g.ox + (jx + 0.5) * g.cs
		local z = g.oz + (jz + 0.5) * g.cs
		return math.sqrt((x - bx) ^ 2 + (z - bz) ^ 2), x, z
	end

local function safeCell(key)
		if not dangerActive then return true end
		local _, x, z = bdist(key)
		return not Z.hit(zs, x, z)
	end

local function penalty(nk)
		local p = 0
		local e = g.edge[nk] or 9
		if e <= 1 then p += 1.5 elseif e == 2 then p += 0.4 end
		if not g.good[nk] then p += 2 end
		local d, x, z = bdist(nk)
		if d < 12 then p += 4 end
		if dangerActive and Z.hit(zs, x, z) then p += 30 end
		return p
	end

for pass = 1, 2 do
		local needGood = (pass == 1)
		local isGoal, hf
		if mode == "approach" then
			isGoal = function(key) return bdist(key) <= keep and (not needGood or g.good[key]) and safeCell(key) end
			hf = function(key) return math.max(0, bdist(key) - keep) end
		elseif mode == "retreat" then
			isGoal = function(key) return bdist(key) >= keep and (not needGood or g.good[key]) and safeCell(key) end
			hf = function(key) return math.max(0, keep - bdist(key)) end
		else
			isGoal = function(key)
				return g.good[key] and math.abs(bdist(key) - keep) <= tol + g.cs and safeCell(key)
			end
			hf = function() return 0 end
		end
		local path = astar(startKey, isGoal, hf, 3500, penalty)
		if path then
			local pts = {}
			for _, key in ipairs(path) do table.insert(pts, cellPos(key)) end
			return pts
		end
	end
	return nil
end

