local function getChar()
	local c = player.Character
	if not c then return nil end
	return c, c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function pressKey(keyCode)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
end

-- Chỉ dùng chiêu khi đã đi tới đúng khoảng cách Distance quanh boss (khi Keep Distance bật)
local function inSkillRange()
	if not keepOn then return true end
	local _, hrp = getChar()
	if not (hrp and currentTarget and currentTarget.Parent) then return false end
	local d = flat(hrp.Position - currentTarget.Position).Magnitude
	return d <= keepDistance + CONFIG.DistanceTolerance
end

