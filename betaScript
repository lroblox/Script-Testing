-- toàn bộ hệ thống vote bọc trong do ... end
do
----------------------------------------------------------------
-- Remote: học / dò / gửi
----------------------------------------------------------------
local VOTE_WORDS = { "replay", "retry", "next", "vote", "again", "continue", "restart" }
local NOISE_WORDS = { "move", "walk", "camera", "ping", "heartbeat", "input", "mouse", "key", "skill",
	"attack", "combat", "punch", "dash", "dodge", "cooldown", "sprint", "run", "ability" }

local learned = {}
local hookOk = false

pcall(function()
	if hookmetamethod and getnamecallmethod then
		local old
		local function handler(self, ...)
			local m = getnamecallmethod()
			if learnMode and os.clock() < learnUntil and (m == "FireServer" or m == "InvokeServer") then
				if typeof(self) == "Instance" and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction") then
					table.insert(learnLog, { remote = self, method = m, args = table.pack(...) })
				end
			end
			return old(self, ...)
		end
		old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
		hookOk = true
	end
end)

local function argsToString(args)
	local t = {}
	for i = 1, (args.n or #args) do t[i] = tostring(args[i]) end
	return table.concat(t, ", ")
end

local function finishLearn(mode, strict)
	local best, bestScore
	for idx, e in ipairs(learnLog) do
		local name = e.remote.Name:lower()
		local score = idx * 0.01
		for _, w in ipairs(NOISE_WORDS) do
			if name:find(w, 1, true) then score -= 5 break end
		end
		for _, w in ipairs(VOTE_WORDS) do
			if name:find(w, 1, true) then score += 3 end
			for i = 1, e.args.n do
				local a = e.args[i]
				if type(a) == "string" and a:lower():find(w, 1, true) then score += 4 end
			end
		end
		if not bestScore or score > bestScore then best, bestScore = e, score end
	end
	learnLog = {}
	local need = strict and 3 or -4
	if best and bestScore >= need then
		learned[mode] = best
		local info = best.remote:GetFullName() .. " (" .. argsToString(best.args) .. ")"
		print("[LotScript] Đã học " .. mode .. ": " .. info)
		voteStatus.Text = "Đã học " .. mode .. ": " .. best.remote.Name .. " (" .. argsToString(best.args) .. ")"
		return true
	end
	if not strict then
		voteStatus.Text = "Không bắt được remote nào. Thử lại và bấm nút thật trong game ngay sau khi bấm Học."
	end
	return false
end

local function startLearn(mode, label)
	if not hookOk then
		voteStatus.Text = "Executor không hỗ trợ hook. Dùng 'Quét remote'."
		return
	end
	learnLog = {}
	learnMode = mode
	learnUntil = os.clock() + 8
	voteStatus.Text = "BẤM NÚT " .. label .. " THẬT trong game ngay (8 giây)..."
	task.delay(8.2, function()
		if learnMode == mode then
			learnMode = nil
			finishLearn(mode, false)
		end
	end)
end

local remoteCache, remoteCacheAt = nil, 0
local function allRemotes()
	if remoteCache and os.clock() - remoteCacheAt < 5 then return remoteCache end
	local out = {}
	for _, v in ipairs(game:GetDescendants()) do
		if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then table.insert(out, v) end
	end
	remoteCache, remoteCacheAt = out, os.clock()
	return out
end

local function fireRemote(r, args)
	task.spawn(function()
		pcall(function()
			local n = args.n or #args
			if r:IsA("RemoteFunction") then
				r:InvokeServer(table.unpack(args, 1, n))
			else
				r:FireServer(table.unpack(args, 1, n))
			end
		end)
	end)
end

scanVoteStrings = function(quiet)
	local found = {}
	local ok = pcall(function()
		if not (getgc and debug and debug.getconstants) then error("no api") end
		local n = 0
		for _, f in ipairs(getgc()) do
			if type(f) == "function" and (not islclosure or islclosure(f)) then
				local okc, consts = pcall(debug.getconstants, f)
				if okc and type(consts) == "table" then
					for _, c in ipairs(consts) do
						if type(c) == "string" and #c >= 4 and #c <= 32 and c:match("^Vote%w*\$") then
							found[c] = true
						end
					end
				end
			end
			n += 1
			if n % 4000 == 0 then task.wait() end
			if n > 120000 then break end
		end
	end)
	local list = {}
	for s in pairs(found) do table.insert(list, s) end
	table.sort(list)
	for _, s in ipairs(list) do
		print("[LotScript] Lệnh Vote:", s)
		local low = s:lower()
		local mode = low:find("replay", 1, true) and "replay" or (low:find("next", 1, true) and "next") or nil
		if mode then
			local cands = CONFIG.VoteArgCandidates[mode]
			local exists = false
			for _, a in ipairs(cands) do if a[1] == s and #a == 1 then exists = true break end end
			if not exists then table.insert(cands, 1, { s }) end
		end
	end
	if not quiet then
		if ok and #list > 0 then
			voteStatus.Text = "Lệnh Vote tìm thấy: " .. table.concat(list, ", ")
		elseif ok then
			voteStatus.Text = "Không thấy chuỗi Vote nào trong code game."
		else
