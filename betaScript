local function excludeList()
	local list = {}
	if player.Character then table.insert(list, player.Character) end
	if currentMob then table.insert(list, currentMob) end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then table.insert(list, pl.Character) end
	end
	return list
end

local function rayParams()
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = excludeList()
	p.RespectCanCollide = true
	p.IgnoreWater = true
	return p
end

local function overlapParams()
	local p = OverlapParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = excludeList()
	p.RespectCanCollide = true
	return p
end

local function hipOffset()
	local _, hrp, hum = getChar()
	if not hrp then return 3 end
	local hip = (hum and hum.HipHeight > 0) and hum.HipHeight or 2
	return hip + hrp.Size.Y / 2
end

local function groundAt(p, refY)
	local hit = workspace:Raycast(Vector3.new(p.X, refY + 12, p.Z), Vector3.new(0, -40, 0), rayParams())
	if not hit then return nil end
	local y = hit.Position.Y + hipOffset()
	if y > refY + 8 then return nil end
	return Vector3.new(p.X, y, p.Z)
end

local function spaceFree(pos)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(2.5, 3, 2.5), overlapParams())
	return #parts == 0
end

