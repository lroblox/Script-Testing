local function isVisible(obj)
	local cur = obj
	while cur and cur ~= playerGui and cur ~= game do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		if cur:IsA("ScreenGui") and not cur.Enabled then return false end
		cur = cur.Parent
	end
	return true
end

local function resultScreenShown()
	for _, v in ipairs(playerGui:GetDescendants()) do
		if (v:IsA("TextLabel") or v:IsA("TextButton")) and not v:IsDescendantOf(gui) then
			local t = v.Text:upper()
			if (t:find("VICTORY", 1, true) or t:find("DEFEAT", 1, true) or t:find("AUTO-RETURN", 1, true))
				and isVisible(v) then
				return true
			end
		end
	end
	return false
end

local voteKeys = { replay = { "replay" }, next = { "nextact" } }

local function findVoteLabel(mode)
	local keys = voteKeys[mode]
	for _, v in ipairs(playerGui:GetDescendants()) do
		if (v:IsA("TextLabel") or v:IsA("TextButton")) and not v:IsDescendantOf(gui) then
			local t = normText(v.Text)
			for _, k in ipairs(keys) do
				if t == k and isVisible(v) and v.AbsoluteSize.X > 0 then return v end
			end
		end
	end
	for _, v in ipairs(playerGui:GetDescendants()) do
		if v:IsA("GuiButton") and not v:IsDescendantOf(gui) then
			local n = normText(v.Name)
			for _, k in ipairs(keys) do
				if n:find(k, 1, true) and isVisible(v) and v.AbsoluteSize.X > 0 then return v end
			end
		end
	end
	return nil
end

local function getVotes(obj)
	local center = obj.AbsolutePosition + obj.AbsoluteSize / 2
	local cur = obj
	for _ = 1, 3 do
		cur = cur and cur.Parent
		if not cur then break end
		local best, bestDist
		for _, v in ipairs(cur:GetDescendants()) do
			if v:IsA("TextLabel") then
				local n = v.Text:upper():match("VOTES%s*(%d+)")
				if n then
					local d = (v.AbsolutePosition + v.AbsoluteSize / 2 - center).Magnitude
					if not bestDist or d < bestDist then best, bestDist = tonumber(n), d end
				end
			end
		end
		if best then return best end
	end
	return nil
end

local function voteSucceeded(mode)
	local lbl = findVoteLabel(mode)
	if lbl then
		local v = getVotes(lbl)
		if v and v >= 1 then return true end
	end
	return false
end

local function collectHandlers(obj)
	local list, seen = {}, {}
	local function add(o)
		if o and not seen[o] and not o:IsDescendantOf(gui) then
			seen[o] = true
			table.insert(list, o)
		end
	end
	local cur = obj
	for _ = 1, 6 do
		if cur and cur:IsA("GuiObject") then add(cur) end
		cur = cur and cur.Parent
	end
	pcall(function()
		local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
		for _, o in ipairs(playerGui:GetGuiObjectsAtPosition(c.X, c.Y)) do add(o) end
	end)
	return list
end

local function fakeInput(state)
	return {
		UserInputType = Enum.UserInputType.MouseButton1,
		UserInputState = state,
		Position = Vector3.new(0, 0, 0),
		Delta = Vector3.new(0, 0, 0),
		KeyCode = Enum.KeyCode.Unknown,
	}
end

local SIGS = { "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "TouchTap", "InputBegan", "InputEnded" }

local function fireHandlers(objs)
	for _, o in ipairs(objs) do
		for _, sg in ipairs(SIGS) do
			pcall(function()
				local sig = o[sg]
				local isInput = (sg == "InputBegan" or sg == "InputEnded")
				local arg = isInput and fakeInput(sg == "InputBegan" and Enum.UserInputState.Begin or Enum.UserInputState.End)
				if getconnections then
					for _, c in ipairs(getconnections(sig)) do
						if isInput then
							c:Fire(arg)
						elseif sg == "Activated" then
							c:Fire(fakeInput(Enum.UserInputState.End), 1)
						else
							c:Fire()
						end
					end
				elseif firesignal then
					if isInput then firesignal(sig, arg) else firesignal(sig) end
				end
			end)
		end
	end
end

local function captureHandlers(mode, objs)
	if not hookOk then
		fireHandlers(objs)
		return
	end
	learnLog = {}
	learnMode = mode
	learnUntil = os.clock() + 1.5
	fireHandlers(objs)
	task.wait(0.6)
	learnMode = nil
	finishLearn(mode, true)
end

