		elseif moveMode == "retreat" then
			if d >= keepDistance then moveMode = nil end
		end

local curKey = grid and cellKeyOf(hrp.Position) or nil
		if moveMode == nil and grid and curKey and grid.walk[curKey] and not grid.good[curKey] and now > settleBlockUntil then
			moveMode = "settle"
		elseif moveMode == "settle" and (not grid or not curKey or grid.good[curKey]) then
			moveMode = nil
		end

local label = (moveMode == "approach" and " (đang đi tới boss)")
			or (moveMode == "retreat" and " (đang lùi ra)")
			or (moveMode == "settle" and " (đang ra chỗ thoáng)") or " (đã đủ - dùng chiêu)"
		keepStatus.Text = string.format("Khoảng cách: %d / %d%s%s%s", math.floor(d), keepDistance, label,
			cframeMode and " [CFrame]" or "", grid and "" or " [map lỗi - vẫn đi thẳng]")

