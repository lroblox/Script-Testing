-- AUTO DODGE: chỉ tele ra khỏi vùng chiêu (ưu tiên số 1)
----------------------------------------------------------------
local function findSafePoint(hrp, maxR, zs)
	local mobPos = currentTarget and currentTarget.Parent and currentTarget.Position or nil
	local limit = keepDistance + CONFIG.DistanceTolerance
	local best, bestScore

if grid then
		local sk, sx, sz = cellKeyOf(hrp.Position)
		if sx then
			local g = grid
			local rc = math.ceil(maxR / g.cs)
			for dx = -rc, rc do
				for dz = -rc, rc do
					local jx, jz = sx + dx, sz + dz
					if jx >= 0 and jz >= 0 and jx < g.N and jz < g.N then
						local key = jx * g.N + jz
						if g.walk[key] then
							local p = cellPos(key)
							local dist = flat(p - hrp.Position).Magnitude
							if dist <= maxR and dist >= 3 and not inDanger(p, zs, true) then
								local score = dist * 0.5
								if not g.good[key] then score += 25 end
								if mobPos then
									local d = flat(p - mobPos).Magnitude
									if d > limit then score += (d - limit) * 2 end
									score += math.abs(d - keepDistance) * 0.3
								end
								if not bestScore or score < bestScore then best, bestScore = p, score end
							end
						end
					end
				end
			end
			if best then return best end
		end
	end

for _, frac in ipairs({ 0.4, 0.7, 1.0 }) do
		local r = maxR * frac
		for a = 0, 330, 30 do
			local ang = math.rad(a)
			local p = hrp.Position + Vector3.new(math.cos(ang), 0, math.sin(ang)) * r
			local gp = groundAt(p, hrp.Position.Y)
			if gp and not inDanger(gp, zs, true) and spaceFree(gp) then
				local score = r * 0.5
				if mobPos then
					local d = flat(gp - mobPos).Magnitude
					if d > limit then score += (d - limit) * 2 end
					score += math.abs(d - keepDistance) * 0.3
				end
				if not bestScore or score < bestScore then best, bestScore = gp, score end
			end
		end
	end
	return best
end

local lastTele = 0
local teleLog = {}
local dodgePausedUntil = 0

local function doDodge(zs)
	local _, hrp = getChar()
	if not hrp then return end
	local now = os.clock()
	if now < dodgePausedUntil then return end
	if now - lastTele < CONFIG.TeleCooldown then return end

for i = #teleLog, 1, -1 do
		if now - teleLog[i] > 3 then table.remove(teleLog, i) end
	end
	if #teleLog >= 6 then
		dodgePausedUntil = now + 1
		teleLog = {}
		dodgeStatus.Text = "Dodge: tele liên tục (" .. lastTrigger .. ") nên nghỉ 1s. Kiểm tra MobAttackRadius / keyword."
		return
	end

lastTele = now
	local base = math.max(teleDistance, 6)
	local p
	for _, mult in ipairs({ 1, 1.6, 2.5, 100 }) do
		local rr = math.min(base * mult, CONFIG.TeleMax)
		p = findSafePoint(hrp, rr, zs)
		if p then break end
	end
	if p then
		table.insert(teleLog, now)
		hrp.CFrame = CFrame.new(p + Vector3.new(0, 0.3, 0)) * (hrp.CFrame - hrp.CFrame.Position)
		dodgeStatus.Text = "Dodge: đã tele (" .. lastTrigger .. ")"
		if resetPath then resetPath() end
	else
		dodgeStatus.Text = "Dodge: không tìm được chỗ an toàn (đã thử tới " .. CONFIG.TeleMax .. " studs)"
	end
end

local function laserSidestepDue()
	local now = os.clock()
	if now >= laserUntil then return false end
	for obj, exp in pairs(laserParts) do
		if obj.Parent and exp > now then return false end
	end
	return now - lastTele >= CONFIG.LaserSidestepEvery
end

