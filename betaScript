----------------------------------------------------------------
-- QUÉT MAP (v6: 2 chế độ — chính xác trước, 0 ô thì tự quét lại loose)
----------------------------------------------------------------
local grid = nil
local scanning = false
local lastScanAt = 0
local mapNote = ""

local function scanMap()
	if scanning then return end
	local _, hrp = getChar()
	if not hrp then return end
	scanning = true
	lastScanAt = os.clock()
	mapNote = "Đang quét map..."

local center = hrp.Position
	if currentTarget and currentTarget.Parent then
		center = (hrp.Position + currentTarget.Position) / 2
	end
	local R, cs = CONFIG.ScanRadius, CONFIG.CellSize
	local N = math.floor(2 * R / cs) + 1
	local ox, oz = center.X - R, center.Z - R
	local g = { N = N, cs = cs, ox = ox, oz = oz, y = {}, walk = {}, edge = {}, good = {}, cx = center.X, cz = center.Z, R = R }
	local hip = hipOffset()
	local refY = hrp.Position.Y

local rp, op = rayParams(), overlapParams()

-- [FIX no-map] chế độ loose: trúng CẢ part không va chạm (sàn mesh) + bỏ check vật cản vô hình
	local rp2 = RaycastParams.new()
	rp2.FilterType = Enum.RaycastFilterType.Exclude
	rp2.FilterDescendantsInstances = excludeList()
	rp2.RespectCanCollide = false
	rp2.IgnoreWater = true

local function scanCells(loose)
		g.walk, g.y = {}, {}
		local hitCount = 0
		for ix = 0, N - 1 do
			for iz = 0, N - 1 do
				local wx = ox + (ix + 0.5) * cs
				local wz = oz + (iz + 0.5) * cs
				-- [FIX] tia dài 90 studs thay vì 60
				local hit = workspace:Raycast(Vector3.new(wx, refY + 12, wz), Vector3.new(0, -90, 0), loose and rp2 or rp)
				if hit and hit.Normal.Y > (loose and 0.3 or 0.65) then
					hitCount += 1
					local gy = hit.Position.Y
					local free = true
					if not loose then
						local parts = workspace:GetPartBoundsInBox(CFrame.new(wx, gy + 3.5, wz), Vector3.new(cs * 0.8, 4, cs * 0.8), op)
						free = #parts == 0
					end
					if free then
						g.walk[ix * N + iz] = true
						g.y[ix * N + iz] = gy + hip
					end
				end
				if (ix * N + iz) % 200 == 0 then task.wait() end
			end
			mapNote = string.format("Đang quét map... %d%%", math.floor(ix / N * 100))
		end
		return hitCount
	end

-- [FIX no-map] quét chính xác trước; 0 ô thì tự quét lại loose + báo rõ lý do
	local hitCount = scanCells(false)
	if hitCount == 0 then
		mapNote = "Tia không trúng sàn (sàn mesh?) — đang quét lại loose..."
		scanCells(true)
	else
		local walk0 = 0
		for _ in pairs(g.walk) do walk0 += 1 end
		if walk0 == 0 then
			mapNote = "Sàn bị part vô hình phủ — đang quét lại loose..."
			scanCells(true)
		end
	end

local dirs4 = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
	local queue, head = {}, 1
	for key in pairs(g.walk) do
		local ix, iz = key // N, key % N
		local seed = false
		for _, d in ipairs(dirs4) do
			local jx, jz = ix + d[1], iz + d[2]
			if jx < 0 or jz < 0 or jx >= N or jz >= N then
				seed = true
			else
				local nk = jx * N + jz
				if not g.walk[nk] or math.abs(g.y[key] - g.y[nk]) > CONFIG.MaxStep then seed = true end
			end
			if seed then break end
		end
		if seed then
			g.edge[key] = 1
			queue[#queue + 1] = key
		end
	end
	while head <= #queue do
		local key = queue[head]
		head += 1
		local ix, iz = key // N, key % N
		local e = g.edge[key]
		for _, d in ipairs(dirs4) do
			local jx, jz = ix + d[1], iz + d[2]
			if jx >= 0 and jz >= 0 and jx < N and jz < N then
				local nk = jx * N + jz
				if g.walk[nk] and not g.edge[nk] then
					g.edge[nk] = e + 1
					queue[#queue + 1] = nk
				end
			end
		end
	end

local function computeGood(th)
		local compOf, bestMembers, bestSize, id = {}, nil, 0, 0
		for key in pairs(g.walk) do
			if (g.edge[key] or 9) >= th and not compOf[key] then
				id += 1
				local stack, members = { key }, {}
				compOf[key] = id
				while #stack > 0 do
					local cur = table.remove(stack)
					members[#members + 1] = cur
					local ix, iz = cur // N, cur % N
					for dx = -1, 1 do
						for dz = -1, 1 do
							if dx ~= 0 or dz ~= 0 then
								local jx, jz = ix + dx, iz + dz
								if jx >= 0 and jz >= 0 and jx < N and jz < N then
									local nk = jx * N + jz
									if g.walk[nk] and not compOf[nk] and (g.edge[nk] or 9) >= th
										and math.abs(g.y[cur] - g.y[nk]) <= CONFIG.MaxStep then
										compOf[nk] = id
										stack[#stack + 1] = nk
									end
								end
							end
						end
					end
				end
				if #members > bestSize then bestMembers, bestSize = members, #members end
			end
		end
		return bestMembers, bestSize
	end

local walkCount = 0
	for _ in pairs(g.walk) do walkCount += 1 end
	if walkCount == 0 then
		mapNote = "Quét map thất bại cả 2 chế độ — Keep Distance vẫn đi thẳng không cần map"
		scanning = false
		return
	end
	local members, size = computeGood(2)
	if not members or size < walkCount * 0.15 then members, size = computeGood(1) end
	if members then
		for _, key in ipairs(members) do g.good[key] = true end
	end
	g.walkCount, g.goodCount = walkCount, members and #members or 0
	grid = g
	mapNote = string.format("Map: %d ô đi được, %d ô an toàn", walkCount, g.goodCount)
	scanning = false
end

requestScan = function(force)
	if scanning then return end
	if not force and grid and os.clock() - lastScanAt < 8 then return end
	task.spawn(function()
		local ok, err = pcall(scanMap)
		if not ok then
			scanning = false
			mapNote = "Lỗi quét map: " .. tostring(err)
		end
	end)
end

local function cellKeyOf(pos)
	if not grid then return nil end
	local ix = math.floor((pos.X - grid.ox) / grid.cs)
	local iz = math.floor((pos.Z - grid.oz) / grid.cs)
	if ix < 0 or iz < 0 or ix >= grid.N or iz >= grid.N then return nil end
	return ix * grid.N + iz, ix, iz
end

local function cellPos(key)
	local N = grid.N
	local ix, iz = key // N, key % N
	return Vector3.new(grid.ox + (ix + 0.5) * grid.cs, grid.y[key], grid.oz + (iz + 0.5) * grid.cs)
end

local function nearestWalk(ix, iz)
	local g = grid
	local N = g.N
	if ix >= 0 and iz >= 0 and ix < N and iz < N and g.walk[ix * N + iz] then return ix * N + iz end
	for r = 1, 5 do
		local best, bd
		for dx = -r, r do
			for dz = -r, r do
				if math.max(math.abs(dx), math.abs(dz)) == r then
					local jx, jz = ix + dx, iz + dz
					if jx >= 0 and jz >= 0 and jx < N and jz < N then
						local nk = jx * N + jz
						if g.walk[nk] then
							local d = dx * dx + dz * dz
							if not bd or d < bd then best, bd = nk, d end
						end
					end
				end
			end
		end
		if best then return best end
	end
	return nil
end

