local variantPtr = { replay = 0, next = 0 }
local working = {}
local lastMethod = {}

local voteMethods = {}

voteMethods.learned = function(mode)
	local L = learned[mode]
	if L and L.remote and L.remote.Parent then
		fireRemote(L.remote, L.args)
		return "remote đã học " .. L.remote.Name .. "(" .. argsToString(L.args) .. ")"
	end
	return nil
end

voteMethods.config = function(mode)
	local cfg = (mode == "replay") and CONFIG.ReplayRemote or CONFIG.NextActRemote
	local n = 0
	for _, r in ipairs(allRemotes()) do
		if (cfg.name ~= "" and r.Name == cfg.name) then
			fireRemote(r, cfg.args)
			n += 1
		end
	end
	if n == 0 and cfg.name == "" then
		for _, k in ipairs(cfg.keywords) do
			for _, r in ipairs(allRemotes()) do
				if r.Name:lower():find(k, 1, true) then
					fireRemote(r, cfg.args)
					n += 1
				end
			end
			if n > 0 then break end
		end
	end
	if n > 0 then return "remote CONFIG " .. cfg.name .. "(" .. argsToString(cfg.args) .. ")" end
	return nil
end

voteMethods.handler = function(mode)
	local lbl = findVoteLabel(mode)
	if not lbl then return nil end
	captureHandlers(mode, collectHandlers(lbl))
	return "hàm xử lý của nút " .. lbl.Name
end

voteMethods.variants = function(mode)
	local cfg = (mode == "replay") and CONFIG.ReplayRemote or CONFIG.NextActRemote
	local remotes = {}
	for _, r in ipairs(allRemotes()) do
		if cfg.name ~= "" and r.Name == cfg.name then table.insert(remotes, r) end
	end
	if #remotes == 0 then
		for _, r in ipairs(allRemotes()) do
			if matchAny(r.Name:lower(), VOTE_WORDS) then table.insert(remotes, r) end
		end
	end
	if #remotes == 0 then return nil end
	local cands = CONFIG.VoteArgCandidates[mode]
	variantPtr[mode] = variantPtr[mode] % #cands + 1
	local args = cands[variantPtr[mode]]
	for _, r in ipairs(remotes) do fireRemote(r, args) end
	return "thử " .. remotes[1].Name .. "(" .. table.concat(args, ", ") .. ")"
end

local DEFAULT_ORDER = { "learned", "config", "handler", "variants", "variants", "variants" }

local function runVoteAttempt(mode, n)
	local order = DEFAULT_ORDER
	if working[mode] and n <= 2 then order = { working[mode] } end
	for k = 0, #order - 1 do
		local name = order[((n - 1 + k) % #order) + 1]
		local desc = voteMethods[name](mode)
		if desc then
			lastMethod[mode] = name
			voteStatus.Text = "Lần " .. n .. ": " .. desc
			print("[LotScript] Vote " .. mode .. " lần " .. n .. ": " .. desc)
			return true
		end
	end
	voteStatus.Text = "Lần " .. n .. ": chưa có cách nào áp dụng được (bấm 'Học' hoặc 'Quét remote')."
	return false
end

