-- Chọn mục tiêu: ưu tiên BOSS (Workspace.Living -> tên -> máu khớp UI -> máu lớn nhất)
----------------------------------------------------------------
local bossUiCache, bossUiAt = {}, 0
local bossCache, bossCacheAt = nil, 0

local function parseUiMax()
	local set = {}
	for _, v in ipairs(playerGui:GetDescendants()) do
		if v:IsA("TextLabel") and not v:IsDescendantOf(gui) then
			local a, b = v.Text:gsub(",", ""):match("^%s*(%d+)%s*/%s*(%d+)%s*\$")
			if b and tonumber(b) >= 1000 then set[tonumber(b)] = true end
		end
	end
	return set
end

local function findNearestMob(hrp)
	local now = os.clock()

if bossCache and now - bossCacheAt < 2 and bossCache.model.Parent and bossCache.root.Parent then
		local h = bossCache.model:FindFirstChildOfClass("Humanoid")
		if not h or h.Health > 0 then
			return bossCache.root, (bossCache.root.Position - hrp.Position).Magnitude, bossCache.name, bossCache.model
		end
	end

if now - bossUiAt > 1 then bossUiCache, bossUiAt = parseUiMax(), now end
	local want = normText(CONFIG.BossName or "")

-- đường nhanh: boss nằm trong Workspace.Living
	if want ~= "" then
		local living = workspace:FindFirstChild("Living")
		if living then
			for _, m in ipairs(living:GetChildren()) do
				if m:IsA("Model") and m ~= player.Character and not ignoreSet[m.Name]
					and not Players:GetPlayerFromCharacter(m) and normText(m.Name):find(want, 1, true) then
					local h = m:FindFirstChildOfClass("Humanoid")
					local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
					if h and h.Health > 0 and r then
						local dist = (r.Position - hrp.Position).Magnitude
						bossCache = { root = r, dist = dist, name = m.Name, model = m }
						bossCacheAt = now
						return r, dist, m.Name, m
					end
				end
			end
		end
	end

local best, bestScore

local function consider(model, hum)
		if not model or not model:IsA("Model") or model == player.Character
			or Players:GetPlayerFromCharacter(model) or ignoreSet[model.Name] then
			return
		end
		if hum then
			if hum.Health <= 0 or hum.MaxHealth >= 1e9 or model:FindFirstChildOfClass("ForceField") then return end
		end
		local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			or model:FindFirstChildWhichIsA("BasePart", true)
		if not root then return end
		local dist = (root.Position - hrp.Position).Magnitude
		local score = -dist * 0.01
		if hum then
			score += math.min(hum.MaxHealth, 1e7) * 0.001
			if bossUiCache[math.floor(hum.MaxHealth + 0.5)] then score += 1e8 end
		else
			score -= 5e8
		end
		if want ~= "" and normText(model.Name):find(want, 1, true) then score += 1e9 end
		if not bestScore or score > bestScore then
			best = { root = root, dist = dist, name = model.Name, model = model }
			bestScore = score
		end
	end

for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Humanoid") then
			consider(d.Parent, d)
		elseif want ~= "" and d:IsA("Model") and normText(d.Name):find(want, 1, true) then
			consider(d, d:FindFirstChildOfClass("Humanoid"))
		end
	end

if not best then
		bossCache = nil
		return nil, math.huge, "", nil
	end
	bossCache, bossCacheAt = best, now
	return best.root, best.dist, best.name, best.model
end

