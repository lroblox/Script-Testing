local dangerParts = {}
local dangerCircles = {}
local laserParts = {}
local beamList = setmetatable({}, { __mode = "k" })
local beamsScanned = false
local attackUntil, laserUntil = 0, 0
local lastTrigger, lastAnim = "", ""
local learnedNames, learnedAnims = {}, {}
local recentCandidates = {}
local virtualAim = nil

local GENERIC = { Part = true, MeshPart = true, Union = true, Wedge = true, HumanoidRootPart = true,
	Handle = true, Baseplate = true, Terrain = true, Head = true, Torso = true }

local function isPlayerPart(inst)
	local cur = inst.Parent
	while cur and cur ~= workspace do
		if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then return true end
		cur = cur.Parent
	end
	return false
end

local function insideRig(part)
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function biggest(p) return math.max(p.Size.X, p.Size.Y, p.Size.Z) end

local function dims(p)
	local t = { p.Size.X, p.Size.Y, p.Size.Z }
	table.sort(t)
	return t[1], t[2], t[3]
end

local function isRed(c)
	return c.R > 0.55 and c.G < 0.4 and c.B < 0.4
end

local function longAxis(p)
	local s = p.Size
	local d1, d2, d3 = dims(p)
	local axis
	if s.X == d3 then axis = p.CFrame.RightVector
	elseif s.Y == d3 then axis = p.CFrame.UpVector
	else axis = p.CFrame.LookVector end
	return axis, d3, d2
end

local function distToSeg(p, a, b)
	local ab = flat(b - a)
	local l2 = ab:Dot(ab)
	if l2 < 1e-4 then return flat(p - a).Magnitude end
	local t = math.clamp(flat(p - a):Dot(ab) / l2, 0, 1)
	return flat(p - (a + (b - a) * t)).Magnitude
end

local function laserSegment(obj)
	if obj:IsA("Beam") then
		local a0, a1 = obj.Attachment0, obj.Attachment1
		if a0 and a1 then
			return a0.WorldPosition, a1.WorldPosition, math.max(obj.Width0, obj.Width1) / 2
		end
		return nil
	end
	local axis, len, wid = longAxis(obj)
	local c = obj.Position
	return c - axis * (len / 2), c + axis * (len / 2), wid / 2
end

local function telegraphMatch(part, color)
	if part.CanCollide then return false end
	local d1, d2, d3 = dims(part)
	if d1 > CONFIG.TelegraphMaxThick or d2 < CONFIG.TelegraphMinSize or d3 > CONFIG.TelegraphMaxSize then
		return false
	end
	local c = color or part.Color
	local dark = (c.R + c.G + c.B) / 3 < 0.12
	return isRed(c) or dark or matchAny(part.Name:lower(), CONFIG.DangerKeywords)
end

local function considerDanger(inst)
	if not dodgeOn then return end
	if inst:IsA("Beam") then
		beamList[inst] = true
		return
	end

if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		local sg = inst:FindFirstAncestorOfClass("SurfaceGui")
		if sg and sg:IsDescendantOf(workspace) then
			local adornee = sg.Adornee or sg.Parent
			if adornee and adornee:IsA("BasePart") and not isPlayerPart(adornee) and not insideRig(adornee) then
				local d1, d2, d3 = dims(adornee)
				if d1 <= CONFIG.TelegraphMaxThick and d2 >= CONFIG.TelegraphMinSize and d3 <= CONFIG.TelegraphMaxSize
					and (isRed(inst.ImageColor3) or matchAny(inst.Name:lower(), CONFIG.DangerKeywords)) then
					dangerParts[adornee] = os.clock() + CONFIG.DangerTTL
					lastTrigger = "vòng ảnh " .. inst.Name
				end
			end
		end
		return
	end

local part, color = inst, nil
	if inst:IsA("Decal") or inst:IsA("Texture") then
		part, color = inst.Parent, inst.Color3
	end
	if not (part and part:IsA("BasePart")) or part == workspace.Terrain then return end
	if isPlayerPart(part) then return end
	local now = os.clock()
	local nameL = part.Name:lower()
	if CONFIG.IgnoreFxNames[nameL] then return end
	if currentTarget and currentTarget.Parent
		and (part.Position - currentTarget.Position).Magnitude > CONFIG.TelegraphNearBoss + 60 then
		return
	end

if part == inst and not part.CanCollide then
		local axis, len, wid = longAxis(part)
		local vertical = math.abs(axis.Y) > 0.8

if vertical and len >= 10 and len >= 3 * wid and not insideRig(part)
			and (isRed(part.Color) or matchAny(nameL, CONFIG.DangerKeywords)) then
			dangerCircles[part] = { exp = now + CONFIG.DangerTTL, r = CONFIG.ColumnRadius }
			lastTrigger = "cột đỏ " .. part.Name
			dbg("Column:", part:GetFullName())
			return
		end

local kw = matchAny(nameL, CONFIG.LaserKeywords)
		if (kw and len >= 6)
			or (not vertical and len >= CONFIG.LaserMinLength and len >= 4 * wid and wid <= 10 and not insideRig(part)) then
			laserParts[part] = now + CONFIG.DangerTTL + 2
			lastTrigger = "laser " .. part.Name
			dbg("Laser part:", part:GetFullName())
			return
		end
	end

if learnedNames[part.Name] or matchAny(nameL, CONFIG.DangerKeywords) then
		dangerParts[part] = now + CONFIG.DangerTTL
		lastTrigger = "part " .. part.Name
		dbg("Danger part:", part:GetFullName())
		return
	end

if not insideRig(part) and telegraphMatch(part, color) then
		dangerParts[part] = now + CONFIG.DangerTTL
		lastTrigger = "vòng cảnh báo " .. part.Name
		dbg("Telegraph:", part:GetFullName(), part.Color)
		return
	end

if inst ~= part then return end

if part.CanCollide or biggest(part) < 4 then return end
	if not currentTarget or (part.Position - currentTarget.Position).Magnitude > 150 then return end
	if now <= attackUntil + 0.6 then
		dangerParts[part] = now + CONFIG.DangerTTL
		lastTrigger = "part lạ " .. part.Name
	else
		table.insert(recentCandidates, { part = part, t = now })
		if #recentCandidates > 40 then table.remove(recentCandidates, 1) end
	end
end
track(workspace.DescendantAdded:Connect(function(i) task.defer(considerDanger, i) end))

local function scanBeams()
